# Required: pick any LiteLLM-supported model string.
# Examples:
#   INGEST_MODEL=openai/<model>
#   INGEST_MODEL=anthropic/<model>
#   INGEST_MODEL=xai/<model>
#   INGEST_MODEL=vertex_ai/<model>
#   INGEST_MODEL=openrouter/<vendor>/<model>
#   INGEST_MODEL=openai/<model> with OPENAI_API_BASE for OpenAI-compatible vendors
INGEST_MODEL=openai/<model>

# Common provider keys. Only set the ones you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=

# OpenAI-compatible fallback for providers like GLM / Minimax / other gateways.
OPENAI_API_BASE=

# Ingest tuning
INGEST_BATCH_SIZE=12
INGEST_MAX_ITEMS=60
INGEST_TOP_N=10
INGEST_SCORE_THRESHOLD=5
INGEST_SUBJECT_PREFIX=AI Ingest

# Delivery. Leave blank to skip email and only write files to out/.
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
INGEST_TO=
